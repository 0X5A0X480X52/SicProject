<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amatrix.sic.iam.dao.OverviewMapper">
  <resultMap id="counters" type="com.amatrix.sic.iam.entity.IamCounters"><constructor>
    <arg column="users" javaType="_long"/><arg column="enabled_users" javaType="_long"/>
    <arg column="roles" javaType="_long"/><arg column="permissions" javaType="_long"/>
  </constructor></resultMap>
  <resultMap id="role" type="com.amatrix.sic.contracts.IamOverviewStats$CountItem"><constructor>
    <arg column="code" javaType="String"/><arg column="name" javaType="String"/><arg column="user_count" javaType="_long"/>
  </constructor></resultMap>
  <select id="counters" resultMap="counters">SELECT (SELECT COUNT(*) FROM app_user) users,
    (SELECT COUNT(*) FROM app_user WHERE enabled=TRUE) enabled_users,
    (SELECT COUNT(*) FROM app_role) roles,(SELECT COUNT(*) FROM app_permission) permissions</select>
  <select id="roleCounts" resultMap="role">SELECT r.code,r.name,COUNT(ur.user_id) user_count FROM app_role r
    LEFT JOIN user_role ur ON ur.role_id=r.id GROUP BY r.id,r.code,r.name ORDER BY r.code</select>
</mapper>
