<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amatrix.sic.workflow.dao.WorkflowSagaMapper">
  <resultMap id="state" type="com.amatrix.sic.workflow.entity.WorkflowSagaState"><constructor>
    <arg column="module_id" javaType="Long"/>
    <arg column="project_id" javaType="Long"/>
    <arg column="current_node_id" javaType="String"/>
    <arg column="current_state" javaType="String"/>
    <arg column="finished" javaType="_boolean"/>
    <arg column="state_id" javaType="Long"/>
    <arg column="seq" javaType="_int"/>
    <arg column="round_no" javaType="_int"/>
    <arg column="event_type" javaType="String"/>
    <arg column="from_state" javaType="String"/>
    <arg column="to_state" javaType="String"/>
    <arg column="from_node_id" javaType="String"/>
    <arg column="to_node_id" javaType="String"/>
    <arg column="result" javaType="String"/>
    <arg column="summary" javaType="String"/>
    <arg column="created_at" javaType="java.time.LocalDateTime"/>
  </constructor></resultMap>
  <select id="find" resultMap="state">SELECT m.id module_id,m.project_id,m.current_node_id,m.current_state,m.finished,s.id state_id,s.seq,s.round_no,
    s.event_type,s.from_state,s.to_state,s.from_node_id,s.to_node_id,s.result,s.summary,s.created_at FROM module_instance m JOIN state_record s ON s.module_instance_id=m.id
    WHERE m.saga_id=#{saga} ORDER BY s.seq DESC LIMIT 1</select>
  <select id="module" resultType="Long">SELECT id FROM module_instance WHERE saga_id=#{saga}</select>
  <insert id="insertModule" useGeneratedKeys="true" keyProperty="id" keyColumn="id">INSERT INTO module_instance(saga_id,project_id,started_by_user_id,module_code,definition_id,current_node_id,current_state,current_seq,current_round,finished)
    VALUES(#{saga},#{project},#{actor},'APPLICATION',#{definition},#{node},#{state},1,1,#{finished})</insert>
  <insert id="snapshot">INSERT INTO project_snapshot(project_id,project_code,project_name,owner_user_id,lifecycle_stage,source_version)
    VALUES(#{project},#{code},#{name},#{actor},'APPLICATION',1) ON DUPLICATE KEY UPDATE project_code=VALUES(project_code),project_name=VALUES(project_name),owner_user_id=VALUES(owner_user_id),lifecycle_stage=VALUES(lifecycle_stage)</insert>
  <insert id="application">INSERT INTO project_application(module_instance_id,project_id,title,limited_project,summary,payload_json) VALUES(#{module},#{project},#{title},#{limited},#{summary},#{json})</insert>
  <delete id="deleteScores">DELETE FROM expert_review_score WHERE assignment_id IN(SELECT id FROM expert_review_assignment WHERE batch_id IN(SELECT id FROM expert_review_batch WHERE module_instance_id=#{id}))</delete>
  <delete id="deleteAssignments">DELETE FROM expert_review_assignment WHERE batch_id IN(SELECT id FROM expert_review_batch WHERE module_instance_id=#{id})</delete>
  <delete id="deleteBatches">DELETE FROM expert_review_batch WHERE module_instance_id=#{id}</delete>
  <delete id="deleteMaterials">DELETE FROM workflow_material_reference WHERE module_instance_id=#{id}</delete>
  <delete id="deleteReviews">DELETE FROM expert_review WHERE module_instance_id=#{id}</delete>
  <delete id="deleteAcceptance">DELETE FROM acceptance_form WHERE module_instance_id=#{id}</delete>
  <delete id="deleteContract">DELETE FROM contract_form WHERE module_instance_id=#{id}</delete>
  <delete id="deleteApplication">DELETE FROM project_application WHERE module_instance_id=#{id}</delete>
  <delete id="deleteForms">DELETE FROM node_form WHERE module_instance_id=#{id}</delete>
  <delete id="deleteTasks">DELETE FROM workflow_task WHERE module_instance_id=#{id}</delete>
  <delete id="deleteStates">DELETE FROM state_record WHERE module_instance_id=#{id}</delete>
  <delete id="deleteModule">DELETE FROM module_instance WHERE id=#{id}</delete>
</mapper>
