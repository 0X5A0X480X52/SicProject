# Copy to .env and replace every CHANGE_ME value. Keep .env out of Git.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
IAM_DB_PASSWORD=CHANGE_ME_IAM_DB
PROJECT_DB_PASSWORD=CHANGE_ME_PROJECT_DB
WORKFLOW_DB_PASSWORD=CHANGE_ME_WORKFLOW_DB
MATERIAL_DB_PASSWORD=CHANGE_ME_MATERIAL_DB
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_DB

RABBITMQ_USERNAME=sic
RABBITMQ_PASSWORD=CHANGE_ME_RABBIT
REDIS_PASSWORD=CHANGE_ME_REDIS
MINIO_ACCESS_KEY=sic-minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO
MINIO_BUCKET=sic-materials
SERVICE_TOKEN_BOOTSTRAP_SECRET=CHANGE_ME_SERVICE_TOKEN

# Used only with the explicit `operations` profile. Keep blank during normal startup.
DLQ_REPLAY_CONFIRM=
DLQ_REPLAY_MAX_MESSAGES=10
DLQ_REPLAY_CONFIRM_TIMEOUT=10s

# Absolute host path of the frozen legacy uploads directory, used only by the migration profile.
LEGACY_UPLOADS_PATH=./migration-input/uploads

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN
BOOTSTRAP_ADMIN_REAL_NAME=系统管理员

# PKCS#8 private key and X.509 public key, each as one Base64 line.
JWT_PRIVATE_KEY=CHANGE_ME_BASE64_PKCS8_PRIVATE_KEY
JWT_PUBLIC_KEY=CHANGE_ME_BASE64_X509_PUBLIC_KEY
JWT_ISSUER=sic-iam
JWT_AUDIENCE=sic-api

# Gateway host port; internal service discovery continues to use port 8080.
GATEWAY_PORT=8080

# Optional replica counts. Gateway and infrastructure remain single-instance.
# SIC_IAM_REPLICAS=1
# SIC_PROJECT_REPLICAS=1
# SIC_WORKFLOW_REPLICAS=1
# SIC_MATERIAL_REPLICAS=1
# SIC_NOTIFICATION_REPLICAS=1
DB_POOL_SIZE=10
# Enable only for explicit load-balancer verification; no credentials are logged.
SIC_LB_EVIDENCE_ENABLED=false
